#include <stdio.h>
#include <string.h>

void expandAroundCenter(char str[], int left, int right,
                        int *start, int *maxLength) {

    while (left >= 0 && str[right] != '\0' &&
           str[left] == str[right]) {

        if (right - left + 1 > *maxLength) {
            *start = left;
            *maxLength = right - left + 1;
        }

        left--;
        right++;
    }
}

int main() {
    char str[100];
    int start = 0, maxLength = 1;
    int i, len;

    printf("Enter a string: ");
    scanf("%s", str);

    len = strlen(str);

    if (len == 0) {
        printf("Empty string\n");
        return 0;
    }

    for (i = 0; i < len; i++) {

        // Odd-length palindrome
        expandAroundCenter(str, i, i, &start, &maxLength);

        // Even-length palindrome
        expandAroundCenter(str, i, i + 1, &start, &maxLength);
    }

    printf("Longest Palindromic Substring: ");

    for (i = start; i < start + maxLength; i++) {
        printf("%c", str[i]);
    }

    printf("\n");

    return 0;
}
